import Init

namespace Pivot

def addCoeffs : List Int → List Int → List Int
  | [], ys => ys
  | xs, [] => xs
  | x :: xs, y :: ys => (x + y) :: addCoeffs xs ys

def scaleCoeffs (q : Int) (xs : List Int) : List Int := xs.map (q * ·)

def mulLinear (a b : Int) (xs : List Int) : List Int :=
  addCoeffs (scaleCoeffs a xs) (0 :: scaleCoeffs b xs)

-- Coefficients in ascending order of the numerator after the Möbius
-- substitution t ↦ (lo + hi*t)/(den*(1+t)).
def transformed (coeffs : List Int) (lo hi den : Int) : List Int :=
  (coeffs.reverse.foldl
    (fun (p, scale) coefficient =>
      (addCoeffs (mulLinear lo hi p) (scaleCoeffs coefficient scale),
       mulLinear den den scale)) ([], [1])).1

def signVariation (xs : List Int) : Nat :=
  let signs := xs.filterMap fun x => if x = 0 then none else some (decide (x < 0))
  (signs.zip signs.tail).countP (fun (a, b) => a != b)

def homogeneousValue (coeffs : List Int) (num den : Int) : Int :=
  (coeffs.reverse.foldl
    (fun (p, scale) coefficient => (p*num + coefficient*scale, scale*den))
    (0, 1)).1

