theorem bracket_variation :
    signVariation (transformed benchmarkCoeffs 4 5 1) = 1 := by decide

theorem bracket_crossing :
    homogeneousValue benchmarkCoeffs 4 1 * homogeneousValue benchmarkCoeffs 5 1 < 0 := by decide

theorem narrow_variation :
    signVariation (transformed benchmarkCoeffs
      4132517078632472854223346853277 4132517078632472854223346853278
      1000000000000000000000000000000) = 1 := by decide

theorem narrow_crossing :
    homogeneousValue benchmarkCoeffs 4132517078632472854223346853277 1000000000000000000000000000000 *
      homogeneousValue benchmarkCoeffs 4132517078632472854223346853278 1000000000000000000000000000000 < 0 := by decide

