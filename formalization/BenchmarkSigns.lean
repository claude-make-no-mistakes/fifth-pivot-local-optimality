-- Specialize z = num / den, clearing the common powers of den.
def atZ (num den : Int) : List Int :=
  (List.range 8).map fun i =>
    homogeneousValue (eliminantCoeffs.map (fun row => row[i]?.getD 0)) num den

def atG (num den : Int) : List Int :=
  eliminantCoeffs.map (fun row => homogeneousValue row num den)

def excluded (coeffs : List Int) (lo hi den : Int) : Bool :=
  decide (signVariation (transformed coeffs lo hi den) = 0 ∧
    homogeneousValue coeffs lo den ≠ 0 ∧ homogeneousValue coeffs hi den ≠ 0)

def crossing (coeffs : List Int) (lo hi den : Int) : Bool :=
  decide (signVariation (transformed coeffs lo hi den) = 1 ∧
    homogeneousValue coeffs lo den * homogeneousValue coeffs hi den < 0)

def noHighGrowth (coeffs : List Int) : Bool :=
  excluded coeffs 4132517078632472854223346853277 4140000000000000000000000000000
    1000000000000000000000000000000

theorem comparator_faces :
    noHighGrowth (atZ 45322490 100000000) = true ∧
    noHighGrowth (atZ 45322501 100000000) = true ∧
    noHighGrowth (eliminantCoeffs.getLastD []) = true ∧
    excluded (atG 414 100) 45322490 45322501 100000000 = true := by decide

def fullFiber (zNumerator : Int) : Bool :=
  crossing (atZ zNumerator 100000000) 413 414 100

def belowCut (zNumerator : Int) : Bool :=
  crossing (atZ zNumerator 100000000) 413000000000000000 413251707863247283
    100000000000000000

theorem attainment_fibers :
    fullFiber 45322490 = true ∧ fullFiber 45322491 = true ∧ fullFiber 45322501 = true ∧
    belowCut 45322490 = true ∧ belowCut 45322501 = true ∧
    crossing (atZ 45322491 100000000) 413251707863247283 414000000000000000
    100000000000000000 = true := by decide


